<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WindowsAiOperator.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test timeouts exist to name a hanging test on CI. -->
    <NoWarn>$(NoWarn);xUnit1069</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WindowsAiOperator.Core\WindowsAiOperator.Core.csproj" />
    <ProjectReference Include="..\..\src\WindowsAiOperator.ModelProviders\WindowsAiOperator.ModelProviders.csproj" />
    <ProjectReference Include="..\..\src\WindowsAiOperator.Storage\WindowsAiOperator.Storage.csproj" />
    <ProjectReference Include="..\..\src\WindowsAiOperator.Presentation\WindowsAiOperator.Presentation.csproj" />
  </ItemGroup>
</Project>
