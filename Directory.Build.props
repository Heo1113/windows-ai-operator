<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Product>Windows AI Operator</Product>
    <Authors>Windows AI Operator contributors</Authors>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Builds the Windows-only projects (WPF, FlaUI) on non-Windows machines too (compile only). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- NuGet package pruning (on by default for .NET 10) fails during restore on SDK 10.0.4xx with the RID-specific
         graphs of the WPF app and wao that use FlaUI ("The given key '(Interop.UIAutomationClient, 10.19041.0)' was not
         present"). Pruning is only an optimization; every package version stays pinned in Directory.Packages.props. -->
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>
</Project>
