<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Independent test GUI for real UI Automation tests. It writes nothing to disk and only changes its own state. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WindowsAiOperator.TestTarget</RootNamespace>
    <AssemblyName>OperatorTestTarget</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>
