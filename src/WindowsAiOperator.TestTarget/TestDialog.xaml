<Window x:Class="WindowsAiOperator.TestTarget.TestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="TestDialog"
        Title="테스트 대화상자" Width="400" Height="220" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <TextBlock Text="테스트용 대화상자입니다." AutomationProperties.AutomationId="DialogMessage" />
    <CheckBox x:Name="DialogOptionCheckBox" Content="옵션 사용" Margin="0,12" AutomationProperties.AutomationId="DialogOptionCheckBox" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="DialogOkButton" Content="확인" Width="80" Margin="0,0,8,0" IsDefault="True" AutomationProperties.AutomationId="DialogOkButton" Click="OnOk" />
      <Button x:Name="DialogCancelButton" Content="취소" Width="80" IsCancel="True" AutomationProperties.AutomationId="DialogCancelButton" />
    </StackPanel>
  </StackPanel>
</Window>
