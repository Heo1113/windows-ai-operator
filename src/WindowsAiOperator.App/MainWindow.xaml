<Window x:Class="WindowsAiOperator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WindowsAiOperator.Presentation.ViewModels;assembly=WindowsAiOperator.Presentation"
        xmlns:views="clr-namespace:WindowsAiOperator.App.Views"
        Title="{Binding Title}" Width="1440" Height="920" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        AutomationProperties.AutomationId="OperatorMainWindow">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TaskRunnerViewModel}"><views:TaskRunnerView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:InspectorViewModel}"><views:InspectorView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:WorkflowLibraryViewModel}"><views:WorkflowLibraryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ModelsViewModel}"><views:ModelsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SafetySettingsViewModel}"><views:SafetySettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
  </Window.Resources>
  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource MockBannerBrush}" Padding="12,6"
            Visibility="{Binding IsMock, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                 Text="MOCK 데스크톱 모드: 실제 Windows 창을 조작하지 않는 가상 화면입니다. 여기서의 성공은 실제 GUI 자동화 성공이 아닙니다." />
    </Border>
    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Windows AI Operator" FontSize="16" FontWeight="SemiBold" Margin="14,14,14,10"
                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}" Background="Transparent" BorderThickness="0"
                 AutomationProperties.AutomationId="Navigation" AutomationProperties.Name="화면 목록">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="4,6" AutomationProperties.Name="{Binding Title}">
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="24" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="14" Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Margin="8" Focusable="False" />
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="긴급 중단 (Ctrl+Alt+F12)" Command="{Binding EmergencyStopCommand}" Style="{StaticResource DangerButton}"
                Margin="6,2,0,2" AutomationProperties.AutomationId="EmergencyStopButton" />
        <TextBlock Text="{Binding StatusLine}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
