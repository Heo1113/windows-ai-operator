<UserControl x:Class="WindowsAiOperator.App.Views.WorkflowLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="WorkflowsPage">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <DockPanel Grid.ColumnSpan="2">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="가져오기…" Command="{Binding ImportCommand}" Style="{StaticResource ToolButton}" />
        <Button Content="새로 고침" Command="{Binding ReloadCommand}" Style="{StaticResource ToolButton}" />
      </StackPanel>
      <TextBlock Text="워크플로" Style="{StaticResource PageTitle}" />
    </DockPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,6"
                   Text="워크플로는 사용자가 [실행]을 누를 때만 실행됩니다. 예약·자동 실행은 없습니다. 모델 없이 동작합니다." />
        <ListBox ItemsSource="{Binding Workflows}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.AutomationId="WorkflowList">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" />
                <TextBlock Text="기본 예시" Style="{StaticResource Caption}" Foreground="{StaticResource InfoBrush}" Visibility="{Binding BuiltIn, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding Selected.Description}" Style="{StaticResource Value}" />
            <TextBlock Text="{Binding DetailError}" Style="{StaticResource WarningText}" Visibility="{Binding DetailError, Converter={StaticResource NotEmptyToVisibility}}" />
            <TextBlock Text="매개변수" Style="{StaticResource FieldLabel}" Visibility="{Binding Parameters.Count, Converter={StaticResource NotEmptyToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Parameters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,2">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="폴더는 [실행]할 때 선택 창에서 고르면 그 실행에서만 목록 읽기를 허용합니다." Style="{StaticResource Caption}"
                               Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,10,0,0">
              <Button Content="실행" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="RunWorkflowButton" />
              <Button Content="사본 만들기" Command="{Binding DuplicateCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="내보내기…" Command="{Binding ExportCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="삭제" Command="{Binding DeleteCommand}" Style="{StaticResource ToolButton}" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="단계" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding StepLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Value}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="필수 승인 조건(미리 판단)" Style="{StaticResource FieldLabel}" />
            <ItemsControl ItemsSource="{Binding ApprovalHints}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Caption}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="실패 처리: 첫 실패에서 멈추고 실행된 변경과 실행하지 않은 단계를 기록합니다." Style="{StaticResource Caption}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="JSON(고급) — 저장할 때 모델 출력과 같은 규칙으로 검사합니다" Style="{StaticResource SectionTitle}" />
            <TextBox Text="{Binding JsonText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                     MinHeight="160" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            <Button Content="JSON 저장" Command="{Binding SaveJsonCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
