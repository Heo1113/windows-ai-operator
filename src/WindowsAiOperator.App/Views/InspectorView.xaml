<UserControl x:Class="WindowsAiOperator.App.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WindowsAiOperator.Presentation.ViewModels;assembly=WindowsAiOperator.Presentation"
             AutomationProperties.AutomationId="InspectorPage">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="380" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.ColumnSpan="3">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <CheckBox Content="모든 창 보기(차단된 창 포함, 읽지 않음)" IsChecked="{Binding ShowAllWindows}" VerticalAlignment="Center" Margin="0,0,10,6" />
          <Button Content="창 목록 새로 고침" Command="{Binding RefreshCommand}" Style="{StaticResource ToolButton}" />
        </StackPanel>
        <TextBlock Text="창 검사기" Style="{StaticResource PageTitle}" />
      </DockPanel>
      <Border Style="{StaticResource Banner}" Visibility="{Binding Notice, Converter={StaticResource NotEmptyToVisibility}}">
        <TextBlock Text="{Binding Notice}" Style="{StaticResource WarningText}" />
      </Border>
    </StackPanel>
    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="창" Style="{StaticResource SectionTitle}" />
        <ListBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.AutomationId="WindowList" AutomationProperties.Name="창 목록">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,3">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Process}" Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding Access}" Style="{StaticResource Caption}" Foreground="{Binding AccessTone, Converter={StaticResource ToneBrush}}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="UI Automation 요소 트리" Style="{StaticResource SectionTitle}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding StructureText}" Foreground="{Binding StructureTone, Converter={StaticResource ToneBrush}}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TreeView x:Name="ElementTree" ItemsSource="{Binding Tree}" SelectedItemChanged="OnSelectedItemChanged"
                  AutomationProperties.AutomationId="ElementTree" AutomationProperties.Name="요소 트리">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate DataType="{x:Type vm:ElementNodeViewModel}" ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Text}" />
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="창 정보" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding WindowProperties}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="이 창을 대상으로 작업 시작" Command="{Binding StartTaskHereCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="선택한 요소" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding ElementProperties}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="화면에서 강조 표시" Command="{Binding HighlightCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="직접 조작(AI 없이, 안전 정책·승인 적용)" Style="{StaticResource SectionTitle}" />
            <WrapPanel>
              <Button Content="누르기" Command="{Binding ClickCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="선택" Command="{Binding SelectCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="펼치기" Command="{Binding ExpandCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="확인란 켜기" Command="{Binding ToggleOnCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="확인란 끄기" Command="{Binding ToggleOffCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="상태 읽기" Command="{Binding ReadCommand}" Style="{StaticResource ToolButton}" />
            </WrapPanel>
            <TextBlock Text="입력할 텍스트" Style="{StaticResource FieldLabel}" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="입력" Command="{Binding SetTextCommand}" Style="{StaticResource ToolButton}" Margin="6,0,0,0" />
              <TextBox Text="{Binding ManualText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="입력할 텍스트" />
            </DockPanel>
            <TextBlock Text="{Binding ActionResult}" Style="{StaticResource Value}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
