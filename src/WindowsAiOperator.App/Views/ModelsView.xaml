<UserControl x:Class="WindowsAiOperator.App.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="ModelsPage">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="모델" Style="{StaticResource PageTitle}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="연결 프로필" Style="{StaticResource SectionTitle}" />
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" MinHeight="160" AutomationProperties.AutomationId="ProfileList" />
            <WrapPanel Margin="0,8,0,0">
              <Button Content="추가" Command="{Binding AddProfileCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="삭제" Command="{Binding DeleteProfileCommand}" Style="{StaticResource ToolButton}" />
            </WrapPanel>
            <Button Content="이 연결을 사용" Command="{Binding SetActiveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
            <TextBlock Text="현재 사용 중인 연결입니다." Style="{StaticResource Caption}" Foreground="{StaticResource GoodBrush}"
                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                       Text="Strata 기본 주소: 엔진 http://127.0.0.1:8080/v1, 데스크톱 앱 http://127.0.0.1:47831/v1. 모델 이름은 [연결 확인]으로 서버 목록에서 고릅니다." />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="연결 설정" Style="{StaticResource SectionTitle}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="이름" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="종류" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding EditKind}" DisplayMemberPath="Label" />
                <TextBlock Text="서버 주소(OpenAI 호환, /v1 포함)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding EditBaseUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="서버 주소" />
                <TextBlock Text="모델(서버 목록에서 선택)" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding AvailableModels}" Text="{Binding EditModel, UpdateSourceTrigger=LostFocus}" IsEditable="True" />
                <TextBlock Text="{Binding ScopeText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                <CheckBox Content="이 PC 밖의 서버로 화면 텍스트 전송 허용(외부·클라우드 모델 사용)" IsChecked="{Binding EditAllowRemote}" Margin="0,8,0,0" />
                <CheckBox Content="이 PC 밖의 서버로 화면 이미지(스크린샷) 전송 허용" IsChecked="{Binding EditAllowRemoteScreenshots}" IsEnabled="{Binding EditAllowRemote}" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="API 키" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding KeySources}" SelectedItem="{Binding EditKeySource}" DisplayMemberPath="Label" />
                <TextBlock Text="환경 변수 이름(예: STRATA_API_KEY)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding EditKeyVariable, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="키 직접 입력(Windows DPAPI로 암호화 저장, 화면·설정 파일·로그에 남지 않음)" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="키 저장" Click="OnStoreKey" Style="{StaticResource ToolButton}" Margin="6,0,0,0" IsEnabled="{Binding SecretStoreAvailable}" />
                  <PasswordBox x:Name="KeyBox" AutomationProperties.Name="API 키" />
                </DockPanel>
                <TextBlock Text="저장된 키가 있습니다." Style="{StaticResource Caption}" Visibility="{Binding HasStoredKey, Converter={StaticResource BoolToVisibility}}" />
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="응답 제한(초)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditTimeout}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="최대 출력 토큰" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditMaxTokens}" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="온도" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditTemperature}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="구조화 출력(response_format)" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding FormatModes}" SelectedItem="{Binding EditFormat}" DisplayMemberPath="Label" />
                <TextBlock Text="화면 이미지(비전) 사용" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding VisionModes}" SelectedItem="{Binding EditVision}" DisplayMemberPath="Label" />
              </StackPanel>
            </Grid>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="저장" Command="{Binding SaveCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="연결 확인" Command="{Binding ProbeCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="ProbeButton" />
              <Button Content="이미지 입력 테스트" Command="{Binding TestVisionCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="응답 형식 검사" Command="{Binding TestFormatCommand}" Style="{StaticResource ToolButton}" />
            </WrapPanel>
            <TextBlock Text="확인 중…" Style="{StaticResource Caption}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Value}" Foreground="{Binding ConnectionTone, Converter={StaticResource ToneBrush}}" AutomationProperties.AutomationId="ConnectionText" />
            <TextBlock Text="{Binding CapabilityText}" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding VisionText}" Style="{StaticResource Value}" Foreground="{Binding VisionTone, Converter={StaticResource ToneBrush}}" />
            <TextBox Text="{Binding TestResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,6,0,0"
                     Visibility="{Binding TestResult, Converter={StaticResource NotEmptyToVisibility}}" />
          </StackPanel>
        </Border>
      </Grid>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="모델 성능 비교(고정 시나리오)" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Caption}"
                     Text="같은 요청을 연결마다 새로 연 테스트 앱에서 실행합니다. 승인이 필요한 단계는 자동으로 거부해 개입 횟수로 셉니다. '계획 유효'와 '실제 GUI 성공'을 따로 셉니다." />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="연결" Style="{StaticResource FieldLabel}" />
              <ItemsControl ItemsSource="{Binding CompareProfiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="시나리오" Style="{StaticResource FieldLabel}" />
              <ItemsControl ItemsSource="{Binding Scenarios}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
          <CheckBox Content="실제 테스트 앱(OperatorTestTarget.exe)에서 실행 — 끄면 가상 테스트 앱(MOCK)" IsChecked="{Binding UseRealTestApp}" IsEnabled="{Binding CanUseRealTestApp}" Margin="0,8,0,0" />
          <WrapPanel Margin="0,8,0,0">
            <Button Content="비교 실행" Command="{Binding RunComparisonCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Content="중지" Command="{Binding StopComparisonCommand}" Style="{StaticResource ToolButton}" />
          </WrapPanel>
          <TextBlock Text="{Binding EvaluationProgress}" Style="{StaticResource Value}" />
          <DataGrid ItemsSource="{Binding EvalSummary}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,8,0,0" MaxHeight="220"
                    CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="연결" Binding="{Binding Label}" />
              <DataGridTextColumn Header="모델" Binding="{Binding Model}" />
              <DataGridTextColumn Header="GUI 성공률" Binding="{Binding SuccessRate}" />
              <DataGridTextColumn Header="계획 유효" Binding="{Binding PlanRate}" />
              <DataGridTextColumn Header="평균 단계" Binding="{Binding AvgSteps, StringFormat=0.0}" />
              <DataGridTextColumn Header="평균 시간(초)" Binding="{Binding AvgSeconds, StringFormat=0.0}" />
              <DataGridTextColumn Header="모델 호출" Binding="{Binding ModelCalls}" />
              <DataGridTextColumn Header="응답 오류" Binding="{Binding ModelErrors}" />
              <DataGridTextColumn Header="잘못된 대상" Binding="{Binding WrongTargets}" />
              <DataGridTextColumn Header="사용자 개입" Binding="{Binding Interventions}" />
            </DataGrid.Columns>
          </DataGrid>
          <DataGrid ItemsSource="{Binding EvalRuns}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,8,0,0" MaxHeight="260"
                    CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="시각" Binding="{Binding At, StringFormat=MM-dd HH:mm}" />
              <DataGridTextColumn Header="연결" Binding="{Binding ProfileName}" />
              <DataGridTextColumn Header="시나리오" Binding="{Binding Scenario}" />
              <DataGridCheckBoxColumn Header="MOCK" Binding="{Binding IsMock}" />
              <DataGridCheckBoxColumn Header="계획 유효" Binding="{Binding PlanValid}" />
              <DataGridCheckBoxColumn Header="GUI 성공" Binding="{Binding GuiSuccess}" />
              <DataGridTextColumn Header="단계" Binding="{Binding Steps}" />
              <DataGridTextColumn Header="ms" Binding="{Binding DurationMs}" />
              <DataGridTextColumn Header="상태" Binding="{Binding Status}" />
              <DataGridTextColumn Header="비고" Binding="{Binding Note}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
