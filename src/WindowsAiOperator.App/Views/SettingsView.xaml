<UserControl x:Class="WindowsAiOperator.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="SettingsPage">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="저장" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
        <TextBlock Text="설정" Style="{StaticResource PageTitle}" />
      </DockPanel>
      <Border Style="{StaticResource Banner}" Visibility="{Binding ResultText, Converter={StaticResource NotEmptyToVisibility}}">
        <TextBlock Text="{Binding ResultText}" Style="{StaticResource Value}" />
      </Border>
      <UniformGrid Columns="2">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="일반" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="테마" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Label" />
            <TextBlock Style="{StaticResource FieldLabel}">
              <Run Text="글자·화면 크기 배율 " /><Run Text="{Binding FontScale, StringFormat=0.00, Mode=OneWay}" /><Run Text=" (Windows 배율 175% 등에 추가로 적용)" />
            </TextBlock>
            <Slider Minimum="0.8" Maximum="2.0" Value="{Binding FontScale}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
            <TextBlock Text="로그 수준(로그에는 비밀정보를 가린 내용만 기록)" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding SelectedLogLevel}" DisplayMemberPath="Label" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="기록과 스크린샷" Style="{StaticResource SectionTitle}" />
            <CheckBox Content="화면 인식에 쓴 스크린샷 저장(기본 꺼짐, 민감한 화면이 저장될 수 있음)" IsChecked="{Binding SaveScreenshots}" Margin="0,2" />
            <TextBlock Text="스크린샷 보존 기간(일)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding ScreenshotRetentionDays}" />
            <TextBlock Text="작업 기록 보존 기간(일)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding HistoryRetentionDays}" />
            <TextBlock Text="자동 백업 간격(일, 0이면 끔)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding AutoBackupDays}" />
          </StackPanel>
        </Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="데이터 저장 위치" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Value}" />
          <TextBlock Text="{Binding DataMode}" Style="{StaticResource Caption}" />
          <TextBlock Text="{Binding StoreSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
          <Button Content="데이터 폴더 열기" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="백업과 복원" Style="{StaticResource SectionTitle}" />
          <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MaxHeight="180">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock>
                  <Run Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Path, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Margin="0,6,0,0">
            <Button Content="지금 백업" Command="{Binding BackupNowCommand}" Style="{StaticResource ToolButton}" />
            <Button Content="선택한 백업에서 복원…" Command="{Binding RestoreCommand}" Style="{StaticResource ToolButton}" />
            <Button Content="무결성 검사" Command="{Binding CheckIntegrityCommand}" Style="{StaticResource ToolButton}" />
            <Button Content="오래된 기록 정리…" Command="{Binding ApplyRetentionCommand}" Style="{StaticResource ToolButton}" />
          </WrapPanel>
          <TextBlock Style="{StaticResource Caption}" Text="복원하기 전에 현재 데이터를 자동으로 백업합니다. 설정(settings.json)과 암호화된 키(secrets.dat)는 백업 대상이 아닙니다." />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="정보" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding Version}" Style="{StaticResource Value}" />
          <TextBlock Text="{Binding Components}" Style="{StaticResource Caption}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
