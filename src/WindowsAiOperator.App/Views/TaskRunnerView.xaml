<UserControl x:Class="WindowsAiOperator.App.Views.TaskRunnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="TaskRunnerPage">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="6">
        <TextBlock Text="작업 실행" Style="{StaticResource PageTitle}" />
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="요청(자연어)" Style="{StaticResource CardTitle}" />
            <TextBox Text="{Binding RequestText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="200"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="RequestBox" AutomationProperties.Name="요청" />
            <TextBlock Text="예시" Style="{StaticResource FieldLabel}" />
            <ItemsControl ItemsSource="{Binding ExampleRequests}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding}" HorizontalContentAlignment="Left" Margin="0,0,0,3" Padding="6,2"
                          Command="{Binding DataContext.UseExampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <Button.ContentTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
                      </DataTemplate>
                    </Button.ContentTemplate>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="시작 대상 창" Style="{StaticResource FieldLabel}" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="새로 고침" Command="{Binding RefreshWindowsCommand}" Style="{StaticResource ToolButton}" Margin="6,0,0,0" />
              <ComboBox ItemsSource="{Binding TargetWindows}" SelectedItem="{Binding SelectedTargetWindow}" DisplayMemberPath="Label" AutomationProperties.Name="시작 대상 창" />
            </DockPanel>
            <TextBlock Text="이 작업에서 목록을 읽을 폴더(파일 내용은 읽지 않음)" Style="{StaticResource FieldLabel}" />
            <ItemsControl ItemsSource="{Binding GrantedFolders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,1">
                    <Button DockPanel.Dock="Right" Content="빼기" Padding="6,0"
                            Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="폴더 추가…" Command="{Binding AddFolderCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,4,0,0" />
            <TextBlock Text="모델" Style="{StaticResource FieldLabel}" />
            <TextBlock Text="{Binding ModelLabel}" Style="{StaticResource Value}" />
            <TextBlock Text="{Binding ModelProblem}" Style="{StaticResource WarningText}" Visibility="{Binding ModelProblem, Converter={StaticResource NotEmptyToVisibility}}" />
            <WrapPanel Margin="0,10,0,0">
              <Button Content="계획 및 실행" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="RunButton" />
              <Button Content="일시정지" Command="{Binding PauseCommand}" Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="PauseButton" />
              <Button Content="재개" Command="{Binding ResumeCommand}" Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="ResumeButton" />
              <Button Content="중단" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" AutomationProperties.AutomationId="StopButton" />
            </WrapPanel>
            <WrapPanel>
              <Button Content="워크플로로 저장" Command="{Binding SaveAsWorkflowCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="화면 지우기" Command="{Binding ClearCommand}" Style="{StaticResource ToolButton}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="160" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                     Foreground="{Binding StatusTone, Converter={StaticResource ToneBrush}}" AutomationProperties.AutomationId="RunStatus" />
          <TextBlock Style="{StaticResource Caption}">
            <Run Text="{Binding Progress, Mode=OneWay}" /><Run Text="  대상 앱: " /><Run Text="{Binding TargetApp, Mode=OneWay}" />
          </TextBlock>
          <Border Style="{StaticResource Banner}" Margin="0,8,0,0" Visibility="{Binding Report, Converter={StaticResource NotEmptyToVisibility}}">
            <StackPanel>
              <TextBlock Text="결과 보고" Style="{StaticResource CardTitle}" />
              <TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                       AutomationProperties.AutomationId="ReportBox" BorderThickness="0" Background="Transparent" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="1">
        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource ApprovalBorderBrush}" BorderThickness="2"
                Visibility="{Binding PendingApproval, Converter={StaticResource NotEmptyToVisibility}}">
          <StackPanel>
            <TextBlock Text="승인 대기 — 별도 승인 창에서도 응답할 수 있습니다" Style="{StaticResource WarningText}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PendingApproval.Change}" Style="{StaticResource Value}" />
            <TextBlock Text="{Binding PendingApproval.Impact}" Style="{StaticResource Caption}" />
            <WrapPanel Margin="0,6,0,0">
              <Button Content="승인하고 실행" Command="{Binding PendingApproval.ApproveCommand}" Style="{StaticResource PrimaryButton}" />
              <Button Content="거부" Command="{Binding PendingApproval.DenyCommand}" Style="{StaticResource ToolButton}" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                Visibility="{Binding PendingPlanReview, Converter={StaticResource NotEmptyToVisibility}}">
          <StackPanel>
            <TextBlock Text="계획 확인 대기 — 단계를 확인하고 [실행]을 누르세요" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding PendingPlanReview.Steps}" MaxHeight="160">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Value}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,6,0,0">
              <Button Content="실행" Command="{Binding PendingPlanReview.StartCommand}" Style="{StaticResource PrimaryButton}" />
              <Button Content="취소" Command="{Binding PendingPlanReview.CancelCommand}" Style="{StaticResource ToolButton}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      <Border Grid.Row="2" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="실행 단계" Style="{StaticResource SectionTitle}" />
          <TextBlock DockPanel.Dock="Top" Text="아직 단계가 없습니다. 요청을 실행하면 계획한 단계와 진행 상황이 여기에 표시됩니다." Style="{StaticResource Caption}"
                     Visibility="{Binding Steps.Count, Converter={StaticResource EmptyToVisibility}}" />
          <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding CurrentStep, Mode=OneWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.AutomationId="StepList" AutomationProperties.Name="실행 단계">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Sequence}" Style="{StaticResource Caption}" />
                  <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{Binding StatusTone, Converter={StaticResource ToneBrush}}" TextWrapping="Wrap" />
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="{Binding IsCurrent, Converter={StaticResource BoolToFontWeight}}" />
                    <TextBlock Text="{Binding Target}" Style="{StaticResource Caption}" Visibility="{Binding Target, Converter={StaticResource NotEmptyToVisibility}}" />
                    <TextBlock Text="{Binding Decision}" Style="{StaticResource Caption}" Visibility="{Binding Decision, Converter={StaticResource NotEmptyToVisibility}}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVisibility}}" />
                    <TextBlock Text="{Binding ReadValue, StringFormat=읽은 값: {0}}" Style="{StaticResource Caption}" Foreground="{StaticResource InfoBrush}"
                               Visibility="{Binding ReadValue, Converter={StaticResource NotEmptyToVisibility}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Row="3" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="이벤트" Style="{StaticResource CardTitle}" />
          <ListBox ItemsSource="{Binding Events}" FontSize="12" AutomationProperties.AutomationId="EventList" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
