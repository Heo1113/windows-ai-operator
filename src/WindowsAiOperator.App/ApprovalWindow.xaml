<Window x:Class="WindowsAiOperator.App.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WindowsAiOperator.Presentation.ViewModels;assembly=WindowsAiOperator.Presentation"
        Title="Windows AI Operator — 확인 필요" Width="680" SizeToContent="Height" MaxHeight="900"
        Topmost="True" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextPrimaryBrush}">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:ApprovalViewModel}">
      <Border BorderBrush="{StaticResource ApprovalBorderBrush}" BorderThickness="2" CornerRadius="8" Padding="16" Margin="10">
        <StackPanel>
          <TextBlock Text="승인 요청" Style="{StaticResource Caption}" />
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,10" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="위험도:" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding RiskText}" FontWeight="SemiBold" Foreground="{Binding RiskTone, Converter={StaticResource ToneBrush}}" Margin="0,2" />
          </StackPanel>
          <TextBlock Text="대상" Style="{StaticResource FieldLabel}" />
          <TextBlock Text="{Binding Target}" Style="{StaticResource Value}" />
          <TextBlock Text="변경 내용" Style="{StaticResource FieldLabel}" />
          <TextBlock Text="{Binding Change}" Style="{StaticResource Value}" FontWeight="SemiBold" />
          <TextBlock Text="영향 범위" Style="{StaticResource FieldLabel}" />
          <TextBlock Text="{Binding Impact}" Style="{StaticResource Value}" />
          <TextBlock Text="복구 방법" Style="{StaticResource FieldLabel}" />
          <TextBlock Text="{Binding Recovery}" Style="{StaticResource Value}" />
          <TextBlock Text="판단 근거" Style="{StaticResource FieldLabel}" />
          <ItemsControl ItemsSource="{Binding Reasons}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat=· {0}}" Style="{StaticResource Caption}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
            <TextBlock Text="클릭 위치 미리보기(빨간 원)" Style="{StaticResource FieldLabel}" />
            <Viewbox MaxHeight="300" Stretch="Uniform" HorizontalAlignment="Left">
              <Grid>
                <Image Source="{Binding PreviewPng, Converter={StaticResource PngToImage}}" Stretch="None" />
                <Canvas>
                  <Ellipse Width="24" Height="24" Stroke="Red" StrokeThickness="3"
                           Canvas.Left="{Binding PreviewX}" Canvas.Top="{Binding PreviewY}">
                    <Ellipse.RenderTransform>
                      <TranslateTransform X="-12" Y="-12" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                </Canvas>
              </Grid>
            </Viewbox>
          </StackPanel>
          <TextBlock Margin="0,12,0,4" Style="{StaticResource WarningText}">
            <Run Text="남은 시간 " /><Run Text="{Binding RemainingSeconds, Mode=OneWay}" /><Run Text="초 — 응답이 없으면 실행하지 않습니다. 승인해도 실행 직전에 대상을 다시 확인합니다." />
          </TextBlock>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="승인하고 실행(_A)" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="ApproveButton" />
            <Button Content="거부" Command="{Binding DenyCommand}" Style="{StaticResource ToolButton}" IsDefault="True" IsCancel="True" AutomationProperties.AutomationId="DenyButton" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlanReviewViewModel}">
      <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="8" Padding="16" Margin="10">
        <StackPanel>
          <TextBlock Text="계획 확인 — 실행 전에 단계를 확인하세요" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBlock Text="요청" Style="{StaticResource FieldLabel}" />
          <TextBlock Text="{Binding Request}" Style="{StaticResource Value}" />
          <TextBlock Text="계획한 모델" Style="{StaticResource FieldLabel}" />
          <TextBlock Text="{Binding PlannerLabel}" Style="{StaticResource Value}" />
          <TextBlock Text="요약" Style="{StaticResource FieldLabel}" />
          <TextBlock Text="{Binding Summary}" Style="{StaticResource Value}" />
          <TextBlock Text="단계" Style="{StaticResource FieldLabel}" />
          <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Value}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="승인이 필요할 것으로 보이는 단계" Style="{StaticResource FieldLabel}" Visibility="{Binding Hints.Count, Converter={StaticResource NotEmptyToVisibility}}" />
          <ItemsControl ItemsSource="{Binding Hints}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat=· {0}}" Style="{StaticResource WarningText}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat=· 계획 경고: {0}}" Style="{StaticResource Caption}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}"
                     Text="실행 중에도 단계마다 안전 정책을 다시 적용하고, 위험한 단계는 따로 승인을 받습니다. 언제든 [중단] 또는 Ctrl+Alt+F12로 멈출 수 있습니다." />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="실행(_R)" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="StartPlanButton" />
            <Button Content="취소" Command="{Binding CancelCommand}" Style="{StaticResource ToolButton}" IsDefault="True" IsCancel="True" AutomationProperties.AutomationId="CancelPlanButton" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <ContentControl x:Name="Host" />
  </ScrollViewer>
</Window>
